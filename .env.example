# Copy to .env and change for your environment.
DATABASE_URL=postgresql+psycopg://taskapi:taskapi@localhost:5432/taskapi
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Creates an admin user on startup if it doesn't exist (handy for local demos only).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-password-123
